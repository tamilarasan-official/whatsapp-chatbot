OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.4-mini
PORT=3000
LLM_TIMEOUT_MS=10000
RATE_LIMIT_PER_MIN=30

# ---- WhatsApp Cloud API (leave empty for dry run: outgoing messages are logged, not sent) ----
# From Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Permanent token of a System User with whatsapp_business_messaging (never a 24-hour test token in production)
WHATSAPP_ACCESS_TOKEN=
# App > App settings > Basic > App secret (signs every webhook delivery)
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value in the webhook configuration
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v22.0
# Where the Act PDFs are publicly served (document messages and citation links)
PUBLIC_ASSETS_BASE=https://valardemo.welocalhost.com/assets
# Bearer token for officer endpoints /api/whatsapp/admin/* (unset = endpoints disabled)
ADMIN_TOKEN=
# Optional: POSTed when a chat is handed to an officer (queue, Slack, email bridge)
HANDOVER_WEBHOOK_URL=
# Optional: approved template name for complaint updates outside the 24-hour window ({{1}} ref, {{2}} status)
WHATSAPP_TEMPLATE_COMPLAINT_UPDATE=
# Session profiles (language, STOP, complaints) are kept here; conversations are in memory only
STATE_DIR=runtime
# SESSION_TTL_MIN=1440   HANDOVER_TTL_MIN=60   WHATSAPP_RATE_LIMIT_PER_MIN=20
