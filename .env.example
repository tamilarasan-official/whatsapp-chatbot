OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.4-mini
PORT=3000
LLM_TIMEOUT_MS=10000
RATE_LIMIT_PER_MIN=30
# Official-website search when the documents do not answer (on by default; "off" to disable)
WEB_SEARCH=on
WEB_SEARCH_DOMAINS=sec.bihar.gov.in,state.bihar.gov.in,egazette.bih.nic.in
WEB_TIMEOUT_MS=15000
# Knowledge-gap log for the weekly report (mount a volume on /app/logs) and the token for /api/admin/gaps
GAP_LOG_FILE=/app/logs/gaps.jsonl
ADMIN_TOKEN=
